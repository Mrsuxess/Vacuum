# ============================================================================
# VACUUM — Solana Wallet Dust Sweeper & Asset Consolidation Platform
# Environment Configuration Template (.env.example)
# ============================================================================

# 1. Solana Network & Server-Enforced Isolation
# Default active network ('devnet' or 'mainnet-beta')
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Optional: Lock the backend strictly to 'devnet' or 'mainnet-beta' so frontend requests cannot switch networks
SERVER_ENFORCED_NETWORK=

# Public RPC URLs used by browser wallet adapter connection
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Server-side RPC URLs used by token discovery, simulation & confirmation verification
# (Recommended for Mainnet: dedicated Helius, QuickNode, or Triton RPC URL)
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# 2. Jupiter Swap API V2 & Price API V3 Configuration
JUPITER_API_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_PRICE_API_URL=https://api.jup.ag/price/v3
# Set JUPITER_API_KEY from https://portal.jup.ag for dedicated Mainnet rate limits
JUPITER_API_KEY=
# Optional integrator referral account & fee (50..255 bps) to recoup sponsorship gas on-chain
JUPITER_REFERRAL_ACCOUNT=
JUPITER_REFERRAL_FEE_BPS=50

# 3. $VACUUM Ecosystem Token Configuration
# Leave NEXT_PUBLIC_VACUUM_TOKEN_MINT blank until official Mainnet token deployment
NEXT_PUBLIC_VACUUM_TOKEN_MINT=
NEXT_PUBLIC_VACUUM_DEVNET_MINT=
NEXT_PUBLIC_VACUUM_TOKEN_DECIMALS=6

# 4. Gasless Fee-Sponsorship Engine (Network-Isolated Server Secrets & Policy)
# NEVER prefix secret keys with NEXT_PUBLIC_
# Never reuse Devnet sponsor keys on Mainnet (enforced automatically by SponsorshipService)
SPONSOR_DEVNET_FEE_PAYER_SECRET_KEY=
SPONSOR_MAINNET_FEE_PAYER_SECRET_KEY=
SPONSOR_FEE_PAYER_SECRET_KEY=

SPONSORSHIP_ENABLED=true
# Mainnet sponsorship is disabled by default (false) until explicitly enabled by the operator
MAINNET_SPONSORSHIP_ENABLED=false
SPONSORSHIP_MIN_SWEEP_USD=0.25
SPONSORSHIP_MAX_PER_WALLET_LAMPORTS=5000000
SPONSORSHIP_MAX_DAILY_BUDGET_LAMPORTS=100000000
SPONSORSHIP_MIN_NET_RECOVERY_USD=0.05
SPONSORSHIP_PLATFORM_FEE_BPS=50
SPONSORSHIP_RATE_LIMIT_PER_HOUR=10
SPONSORSHIP_MAX_PRIORITY_MICRO_LAMPORTS=250000

# 5. Persistence Layer (SQLite WAL via node:sqlite)
DATABASE_PATH=./data/vacuum.db
